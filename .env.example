MONGODB_URI=mongodb://localhost:27017/period-buddy
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10
LOG_LEVEL=debug
# CORS allowlist — comma-separated origins allowed in production. Ignored in
# non-production (all origins reflected for local dev tooling / Expo clients).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://be.thenura.

# Rate limiting. Enabled automatically when NODE_ENV=production; set
# RATE_LIMIT_ENABLED=true/false to force it on/off in any environment.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
# Strict limiter for auth endpoints (login/signup/OTP/account-deletion).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Mail (used by /api/newsletter and /api/contact). Leave blank in dev — emails
# are logged instead of sent when SMTP_HOST/SMTP_USER/SMTP_PASS are unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nura <hello@thenura.care>"
CONTACT_RECEIVER_EMAIL=hello@thenura.care

# OTP (email verification on signup)
OTP_EXPIRY_MINUTES=10

# Google Sign-In — create OAuth 2.0 client IDs at
# https://console.cloud.google.com/apis/credentials (one per platform you
# ship). Any ID token whose `aud` matches one of these is accepted.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=

# AWS S3 (profile pictures & other user uploads via POST /api/upload;
# reel video / guide audio uploads via POST /api/content/media/upload)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional override if you serve the bucket through a CDN/custom domain
AWS_S3_PUBLIC_URL_BASE=

# Sarvam AI — powers all AI features: Documents chat/summarization, health
# report analysis, document text extraction, speech-to-text and
# text-to-speech. Get a key at https://dashboard.sarvam.ai.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3

# Sarvam Instant Outbound (apps.sarvam.ai, informally "Samvaad" elsewhere in
# this codebase) — Sarvam's OWN outbound-calling product, not a separate
# vendor; runs the "Buddy" cycle check-in voice agent over the phone
# (POST /api/voice-agent/checkin-call). Distinct host + auth header from the
# SARVAM_* keys above (which hit api.sarvam.ai). Confirmed against
# docs.sarvam.ai/api-reference/instant-outbound/create.md.
# org_id/workspace_id come from your Sarvam dashboard URL; connection_id
# from Deploy → Phone Numbers; app_id/app_version from the agent itself.
# Requires API_BASE_URL (below) to be set to a publicly reachable HTTPS URL
# — Sarvam POSTs the call outcome to {API_BASE_URL}/api/voice-agent/checkin-call/webhook.
SARVAM_OUTBOUND_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# TTL of the short-lived per-call token passed into the agent as
# agent_variables.user_auth_token, for an agent-side tool that calls back
# into POST /api/cycle/log mid-call (optional — the primary data path is the
# webhook above, not this token).
SAMVAAD_CALL_TOKEN_TTL=30m
# Shared secret an external scheduler (AWS EventBridge Scheduler) sends as
# the X-Scheduler-Secret header to POST /api/voice-agent/checkin-call/
# scheduler-tick, which fires recurring check-in calls (see
# utils/checkinCallScheduler.js). Deliberately NOT an in-process timer —
# this endpoint needs to be triggered externally once a minute instead.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHECKIN_CALL_SCHEDULER_SECRET=

# Shared secret an external scheduler (AWS EventBridge Scheduler) sends as
# the X-Scheduler-Secret header to POST /api/notifications/daily-tick, which
# fires period/ovulation reminders and the daily "log today" nudge (see
# utils/dailyNotificationScheduler.js). Only needs to be triggered once a
# day (unlike CHECKIN_CALL_SCHEDULER_SECRET above, which needs per-minute
# precision) — see README's "Scheduled jobs" section. Separate secret from
# the check-in call one so either can be rotated independently.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_SCHEDULER_SECRET=

# Razorpay — collects payment for gynac consultation bookings. Get keys at
# https://dashboard.razorpay.com/app/keys (test-mode keys work for dev).
# RAZORPAY_KEY_ID is also sent to the frontend to open the checkout widget;
# RAZORPAY_KEY_SECRET must stay server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Base URL of the admin/clinician web app (period-buddy-content) — used to
# build doctor set-password invite links. e.g. https://admin.yourdomain.com
# ADMIN_APP_URL=http://localhost:5173
ADMIN_APP_URL=https://admin.thenura.care

# Base URL of this API itself — used to build the one-click unsubscribe link
# in newsletter emails and Sarvam Instant Outbound's webhook callback URL
# (see SARVAM_* above). e.g. https://api.yourdomain.com. The bare
# backend.thenura.care domain 301-redirects to www — that breaks POST
# requests (Sarvam's webhook won't follow it), so this must be the www host.
# API_BASE_URL=http://localhost:5000
API_BASE_URL=https://backend.thenura.care

# Origin allowed to call GET /api/company-assets/public in production (the
# public company-files listing) — narrower than ALLOWED_ORIGINS above, which
# also covers the mobile app and other pages. Defaults to ADMIN_APP_URL if
# unset; set this only if the public library should be served from a
# different site (e.g. the marketing site instead of the admin app).
# COMPANY_ASSETS_PUBLIC_ORIGIN=https://admin.thenura.care
