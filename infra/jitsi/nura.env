# Nura settings layered over docker-jitsi-meet's own env.example by install.sh.
# Checked against release stable-11248 (docker-compose.yml, prosody
# jitsi-meet.cfg.lua, jicofo.conf, web settings-config.js). Re-check these
# names against the release notes before changing JITSI_RELEASE.
#
# NO SECRETS HERE. JWT_APP_SECRET and the internal passwords are generated
# into /opt/jitsi/docker-jitsi-meet/.env on the host and never committed.
# @DOMAIN@, @EMAIL@ and @PUBLIC_IP@ are filled in by install.sh.

# --- Basics -----------------------------------------------------------------
CONFIG=/opt/jitsi/config
HTTP_PORT=80
HTTPS_PORT=443
TZ=Asia/Kolkata
PUBLIC_URL=https://@DOMAIN@
RESTART_POLICY=unless-stopped
# The host's public (Elastic/static) IP: JVB sits behind 1:1 NAT on AWS.
JVB_ADVERTISE_IPS=@PUBLIC_IP@

# --- HTTPS (trusted certificate, auto-renewed) ------------------------------
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=@DOMAIN@
LETSENCRYPT_EMAIL=@EMAIL@
LETSENCRYPT_ACME_SERVER=letsencrypt
ENABLE_HTTP_REDIRECT=1
ENABLE_HSTS=1
# With Let's Encrypt on, this would otherwise sign the host up for 8x8 JaaS.
ENABLE_JAAS_COMPONENTS=0

# --- Authentication: JWT only, no anonymous or guest access -------------------
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID=nura-api
JWT_ACCEPTED_ISSUERS=nura-api
JWT_ACCEPTED_AUDIENCES=jitsi
JWT_ALLOW_EMPTY=0
JWT_ENABLE_DOMAIN_VERIFICATION=0

# --- Roles come from the token, nothing else ---------------------------------
# token_affiliation: context.user.affiliation "owner" => moderator, else member.
XMPP_MUC_MODULES=token_affiliation
# Jicofo would otherwise make EVERY authenticated (token) user a moderator
# (AuthenticationRoleManager), or the first one in the room (auto-owner).
# Prosody still requires a valid token to connect; jicofo auth only adds the
# login-URL flow we don't use.
JICOFO_ENABLE_AUTH=0
ENABLE_AUTO_OWNER=0
DISABLE_GRANT_MODERATOR=1

# --- Two people per call (patient + doctor, or two Period Buddies) ------------
# 3, not 2: a dropped connection can leave a ghost occupant for a minute,
# which would otherwise lock the reconnecting person out. Tokens are minted only
# only for the two people in that consultation or buddy pairing, so a third
# person can't get in.
MAX_PARTICIPANTS=3
ENABLE_LOBBY=0
ENABLE_BREAKOUT_ROOMS=0
ENABLE_VISITORS=0
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
ENABLE_PREJOIN_PAGE=0
DISABLE_DEEP_LINKING=1
ENABLE_CALENDAR=0

# --- Off until there's a reason and a privacy review ------------------------
ENABLE_RECORDING=0
ENABLE_SERVICE_RECORDING=0
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_FILE_RECORDING_SHARING=0
DISABLE_LOCAL_RECORDING=1
DISABLE_POLLS=1
DISABLE_REACTIONS=1
DISABLE_PRIVATE_CHAT=1
ENABLE_THIRD_PARTY_REQUESTS=0

# Media always goes through our bridge: no peer-to-peer mode (it would expose
# each side's IP address to the other and use third-party STUN servers).
ENABLE_P2P=0

TOOLBAR_BUTTONS=microphone,camera,hangup,settings,fullscreen
