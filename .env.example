MONGODB_URI=mongodb://localhost:27017/period-buddy
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Mail (used by /api/newsletter and /api/contact). Leave blank in dev — emails
# are logged instead of sent when SMTP_HOST/SMTP_USER/SMTP_PASS are unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nura <hello@nuracare.app>"
CONTACT_RECEIVER_EMAIL=hello@nuracare.app
