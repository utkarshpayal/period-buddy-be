MONGODB_URI=mongodb://localhost:27017/period-buddy
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
# Admin Workspace / CMS staff sessions are shorter (they can see other people's data).
STAFF_SESSION_TTL=12h

# Field-level encryption of health data (utils/fieldEncryption.js). REQUIRED in
# production: the server refuses to start without it. "<id>:<base64 of 32 bytes>",
# comma-separated, the first one encrypts; keep old keys listed after a rotation
# until `node src/scripts/encryptExistingData.js --apply` has run. Generate one with
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Keep it in the secrets manager. Losing it means losing the encrypted data.
DATA_ENCRYPTION_KEYS=

# Privacy (utils/privacy.js, utils/accountPurgeRunner.js)
# Turn on once the app release that asks for AI consent is out.
AI_CONSENT_ENFORCED=false
# Days an account deleted in the app is kept before it's wiped for good.
ACCOUNT_PURGE_AFTER_DAYS=30

# Sign-in protection (utils/loginSecurity.js, utils/sessionCookie.js)
# Emailed sign-in code for staff and doctors. Turn on after the Admin Workspace
# and CMS builds with the code screen are deployed (needs RESEND_API_KEY).
STAFF_2FA_ENABLED=false
# Staff sessions in an httpOnly cookie (the Admin Workspace / CMS opt in per
# login). Works only when those sites are on the same site as the API
# (*.thenura.care); they fall back to the token elsewhere.
STAFF_COOKIE_AUTH=false
# Wrong passwords in a row before an account is locked, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Retention in days (utils/retentionRunner.js); 0 keeps forever. Keep in step
# with the privacy policy. AI chats follow each person's own choice in the app.
NOTIFICATION_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=730
USAGE_RETENTION_DAYS=400
BCRYPT_ROUNDS=10
LOG_LEVEL=debug
# CORS allowlist — comma-separated origins allowed in production. Ignored in
# non-production (all origins reflected for local dev tooling / Expo clients).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://be.thenura.

# Rate limiting. Enabled automatically when NODE_ENV=production; set
# RATE_LIMIT_ENABLED=true/false to force it on/off in any environment.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Swagger UI at /api-docs (+ raw spec at /api-docs.json). On by default
# outside production, off in production unless set to true.
# SWAGGER_ENABLED=true
# Strict limiter for auth endpoints (login/signup/OTP/account-deletion).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Mail via Resend (utils/mailer.js) — OTPs, staff/doctor invites, newsletter,
# contact form, suspension notices. Leave blank in dev: emails are logged
# instead of sent when RESEND_API_KEY is unset. Required in production.
# MAIL_FROM's domain must be verified in the Resend dashboard.
RESEND_API_KEY=
MAIL_FROM="Nura <hello@thenura.care>"
CONTACT_RECEIVER_EMAIL=hello@thenura.care

# OTP (email verification on signup)
OTP_EXPIRY_MINUTES=10

# Google Sign-In — create OAuth 2.0 client IDs at
# https://console.cloud.google.com/apis/credentials (one per platform you
# ship). Any ID token whose `aud` matches one of these is accepted.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=

# AWS S3 (profile pictures & other user uploads via POST /api/upload;
# reel video / guide audio uploads via POST /api/content/media/upload)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional override if you serve the bucket through a CDN/custom domain
AWS_S3_PUBLIC_URL_BASE=
# Optional: KMS key for private uploads (medical documents). Without it they
# use S3-managed encryption (SSE-S3). Private folders are never public-read.
AWS_S3_KMS_KEY_ID=

# Sarvam AI — powers all AI features: Documents chat/summarization, health
# report analysis, document text extraction, speech-to-text and
# text-to-speech. Get a key at https://dashboard.sarvam.ai.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3

# Sarvam Instant Outbound (apps.sarvam.ai, informally "Samvaad" elsewhere in
# this codebase) — Sarvam's OWN outbound-calling product, not a separate
# vendor; runs the "Buddy" cycle check-in voice agent over the phone
# (POST /api/voice-agent/checkin-call). Distinct host + auth header from the
# SARVAM_* keys above (which hit api.sarvam.ai). Confirmed against
# docs.sarvam.ai/api-reference/instant-outbound/create.md.
# org_id/workspace_id come from your Sarvam dashboard URL; connection_id
# from Deploy → Phone Numbers; app_id/app_version from the agent itself.
# Requires API_BASE_URL (below) to be set to a publicly reachable HTTPS URL
# — Sarvam POSTs the call outcome to {API_BASE_URL}/api/voice-agent/checkin-call/webhook.
SARVAM_OUTBOUND_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
# Must be a COMMITTED agent version. Dashboard edits go to the draft and
# only reach calls after a commit and a bump here.
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# TTL of the short-lived per-call token passed into the agent as
# agent_variables.user_auth_token. The agent's log_cycle_entry tool uses it
# to save the check-in via POST /api/cycle/log mid-call (the main save path;
# the webhook above backfills anything it missed). Must outlive the call
# plus any Sarvam queue/retry delay.
SAMVAAD_CALL_TOKEN_TTL=2h
# Shared secret an external scheduler (AWS EventBridge Scheduler) sends as
# the X-Scheduler-Secret header to POST /api/voice-agent/checkin-call/
# scheduler-tick, which fires recurring check-in calls (see
# utils/checkinCallScheduler.js). Only needed if you've set up that external
# scheduler AND set ENABLE_IN_PROCESS_SCHEDULER=false (see below) — without
# it, utils/inProcessScheduler.js already ticks this every minute in-process.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHECKIN_CALL_SCHEDULER_SECRET=

# Set to "false" once a real external scheduler (AWS EventBridge, see
# README's "Scheduled jobs" section) is wired up to hit the two
# /scheduler-tick and /daily-tick endpoints directly. Until then, this
# backend runs both recurring jobs (check-in calls, period/ovulation
# reminders) itself via an in-process interval (utils/inProcessScheduler.js)
# — fine for a single-instance deployment, but MUST be disabled (set to
# "false") before scaling to more than one instance, or every instance will
# independently fire the same call/notification.
ENABLE_IN_PROCESS_SCHEDULER=true

# Shared secret an external scheduler (AWS EventBridge Scheduler) sends as
# the X-Scheduler-Secret header to POST /api/notifications/daily-tick, which
# fires period/ovulation reminders and the daily "log today" nudge (see
# utils/dailyNotificationScheduler.js). Only needs to be triggered once a
# day (unlike CHECKIN_CALL_SCHEDULER_SECRET above, which needs per-minute
# precision) — see README's "Scheduled jobs" section. Separate secret from
# the check-in call one so either can be rotated independently.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_SCHEDULER_SECRET=

# Cashfree — collects payment for gynac consultation bookings and premium
# subscriptions (cards, netbanking, wallets, and UPI intent/collect, all
# offered automatically by Cashfree's hosted checkout). Get keys at
# https://merchant.cashfree.com/merchants/pg/credentials (test-mode/sandbox
# keys work for dev). CASHFREE_SECRET_KEY must stay server-only.
# CASHFREE_ENV selects which API host is used and is also sent to the
# frontend so its checkout SDK matches — "sandbox" or "production".
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
# order_meta.return_url base — required by Cashfree for redirect-based
# payment methods (netbanking, wallets, UPI apps) even under the app's
# `_modal` checkout target; without it those methods never signal the
# checkout page that payment finished, so it just hangs. Falls back to
# API_BASE_URL below when unset.
# CASHFREE_RETURN_URL_BASE=https://backend.thenura.care

# Cashfree PAYOUTS — sends doctors' wallet withdrawals to their bank / UPI
# (utils/cashfreePayoutClient.js). A separate Cashfree product from the
# Payment Gateway above, with its own keys: Payouts dashboard → Developers →
# API Keys. Optional: without them withdrawals are paid manually (Commission
# & Payouts → Withdrawals → Pay & mark paid). Adding them doesn't switch
# anything on by itself; a Clinical Admin picks "Cashfree Payouts" under
# Commission & Payouts → Settings. The client secret also verifies payout
# webhooks (POST /api/payouts/webhook/cashfree).
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=
# Payouts only accepts calls from whitelisted IPs, or signed with this public
# key (Developers → Two-Factor Authentication → Public Key). The server IP is
# not fixed, so use the key: the .pem contents, raw or `base64 -w0 key.pem`.
# CASHFREE_PAYOUT_PUBLIC_KEY=
# "sandbox" | "production"; defaults to CASHFREE_ENV.
# CASHFREE_PAYOUT_ENV=sandbox

# Base URL of the admin/clinician web app (period-buddy-content) — used to
# build doctor set-password invite links. e.g. https://admin.yourdomain.com
# ADMIN_APP_URL=http://localhost:5173
ADMIN_APP_URL=https://admin.thenura.care

# People & letters (HR documents in the Admin Workspace). The signing link in
# emailed letters is ADMIN_APP_URL/sign/<token>.
# COMPANY_NAME fills {{companyName}}; HR_DOCUMENT_PREFIX starts document numbers
# (NC/INT/2026/0001); HR_NOTIFY_EMAIL also gets a copy of every signed letter.
# COMPANY_NAME=The Nura Care
# HR_DOCUMENT_PREFIX=NC
# HR_NOTIFY_EMAIL=hr@thenura.care

# Base URL of this API itself — used to build the one-click unsubscribe link
# in newsletter emails and Sarvam Instant Outbound's webhook callback URL
# (see SARVAM_* above). e.g. https://api.yourdomain.com. The bare
# backend.thenura.care domain 301-redirects to www — that breaks POST
# requests (Sarvam's webhook won't follow it), so this must be the www host.
# API_BASE_URL=http://localhost:5000
API_BASE_URL=https://backend.thenura.care

# Origin allowed to call GET /api/company-assets/public in production (the
# public company-files listing) — narrower than ALLOWED_ORIGINS above, which
# also covers the mobile app and other pages. Defaults to ADMIN_APP_URL if
# unset; set this only if the public library should be served from a
# different site (e.g. the marketing site instead of the admin app).
# COMPANY_ASSETS_PUBLIC_ORIGIN=https://admin.thenura.care

# Firebase Admin (push notifications). Paste the service account key JSON,
# raw or base64-encoded (`base64 -w0 key.json`). Alternatively drop the file at
# src/utils/firebase-service-account.json. Without either, pushes are only logged.
FIREBASE_SERVICE_ACCOUNT_JSON=
